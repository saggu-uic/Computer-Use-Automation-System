{
  "$defs": {
    "DataClass": {
      "enum": [
        "public",
        "internal",
        "pii",
        "financial",
        "secret"
      ],
      "title": "DataClass",
      "type": "string"
    },
    "Entry": {
      "additionalProperties": false,
      "properties": {
        "origin": {
          "title": "Origin",
          "type": "string"
        },
        "home_path": {
          "default": "/",
          "title": "Home Path",
          "type": "string"
        },
        "home_screen": {
          "title": "Home Screen",
          "type": "string"
        }
      },
      "required": [
        "origin",
        "home_screen"
      ],
      "title": "Entry",
      "type": "object"
    },
    "ExpectCase": {
      "additionalProperties": false,
      "properties": {
        "screen": {
          "title": "Screen",
          "type": "string"
        },
        "then": {
          "anyOf": [
            {
              "const": "continue",
              "type": "string"
            },
            {
              "$ref": "#/$defs/ThenAction"
            }
          ],
          "default": "continue",
          "title": "Then"
        }
      },
      "required": [
        "screen"
      ],
      "title": "ExpectCase",
      "type": "object"
    },
    "FieldRule": {
      "additionalProperties": false,
      "description": "How to classify data on screen.\n\nmatch keys:\n  table + column          a column in a data table\n  heading_contains + part the part of a heading after the member number\n  section                 the value next to a row label (e.g. MEMBER NOTES)",
      "properties": {
        "match": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Match",
          "type": "object"
        },
        "part": {
          "anyOf": [
            {
              "const": "after_member_number",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Part"
        },
        "classification": {
          "$ref": "#/$defs/DataClass"
        }
      },
      "required": [
        "match",
        "classification"
      ],
      "title": "FieldRule",
      "type": "object"
    },
    "IfMissing": {
      "additionalProperties": false,
      "properties": {
        "then": {
          "$ref": "#/$defs/ThenAction"
        }
      },
      "required": [
        "then"
      ],
      "title": "IfMissing",
      "type": "object"
    },
    "InputHint": {
      "additionalProperties": false,
      "description": "Classification and description for inputs named after a field in this product.",
      "properties": {
        "classification": {
          "$ref": "#/$defs/DataClass",
          "default": "internal"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        }
      },
      "title": "InputHint",
      "type": "object"
    },
    "Locator": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "role",
            "label",
            "near_text",
            "table_cell",
            "table",
            "text",
            "css"
          ],
          "title": "Kind",
          "type": "string"
        },
        "frame": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Frame"
        },
        "role": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Role"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "exact": {
          "default": true,
          "title": "Exact",
          "type": "boolean"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text"
        },
        "direction": {
          "anyOf": [
            {
              "enum": [
                "left",
                "right"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Direction"
        },
        "table": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Table"
        },
        "column": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Column"
        },
        "row_where": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Row Where"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "within_dialog": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Within Dialog"
        },
        "fragile": {
          "default": false,
          "title": "Fragile",
          "type": "boolean"
        }
      },
      "required": [
        "kind"
      ],
      "title": "Locator",
      "type": "object"
    },
    "RoleRef": {
      "additionalProperties": false,
      "properties": {
        "role": {
          "title": "Role",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "role",
        "name"
      ],
      "title": "RoleRef",
      "type": "object"
    },
    "Screen": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "default": "page",
          "enum": [
            "page",
            "outcome",
            "interstitial",
            "needs_human",
            "session_lost",
            "app_error",
            "transient"
          ],
          "title": "Kind",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "match": {
          "items": {
            "$ref": "#/$defs/ScreenPredicate"
          },
          "minItems": 1,
          "title": "Match",
          "type": "array"
        },
        "outcome": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Outcome"
        },
        "may_follow": {
          "items": {
            "type": "string"
          },
          "title": "May Follow",
          "type": "array"
        },
        "handler": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Handler"
        },
        "max_per_run": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Per Run"
        },
        "escalate": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Escalate"
        },
        "fail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fail"
        },
        "proposed": {
          "default": false,
          "title": "Proposed",
          "type": "boolean"
        }
      },
      "required": [
        "match"
      ],
      "title": "Screen",
      "type": "object"
    },
    "ScreenPredicate": {
      "additionalProperties": false,
      "properties": {
        "heading": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Heading"
        },
        "heading_contains": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Heading Contains"
        },
        "text_contains": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text Contains"
        },
        "dialog_text_contains": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dialog Text Contains"
        },
        "route_matches": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Route Matches"
        },
        "role_exists": {
          "anyOf": [
            {
              "$ref": "#/$defs/RoleRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "not": {
          "anyOf": [
            {
              "$ref": "#/$defs/ScreenPredicate"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "frame": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Frame"
        }
      },
      "title": "ScreenPredicate",
      "type": "object"
    },
    "Session": {
      "additionalProperties": false,
      "properties": {
        "login_steps": {
          "items": {
            "$ref": "#/$defs/Step"
          },
          "title": "Login Steps",
          "type": "array"
        }
      },
      "required": [
        "login_steps"
      ],
      "title": "Session",
      "type": "object"
    },
    "Step": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "action": {
          "enum": [
            "click",
            "type",
            "select",
            "check",
            "press_key",
            "accept_dialog",
            "dismiss_dialog",
            "extract",
            "wait"
          ],
          "title": "Action",
          "type": "string"
        },
        "target": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "checked": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Checked"
        },
        "key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Key"
        },
        "risk": {
          "default": "safe",
          "enum": [
            "safe",
            "irreversible"
          ],
          "title": "Risk",
          "type": "string"
        },
        "verify": {
          "anyOf": [
            {
              "const": "value_matches",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Verify"
        },
        "expect": {
          "items": {
            "$ref": "#/$defs/ExpectCase"
          },
          "title": "Expect",
          "type": "array"
        },
        "timeout_ms": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timeout Ms"
        },
        "into": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Into"
        },
        "parse": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parse"
        },
        "columns": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Columns"
        },
        "if_missing": {
          "anyOf": [
            {
              "$ref": "#/$defs/IfMissing"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "origin": {
          "default": "agent",
          "enum": [
            "agent",
            "author",
            "human"
          ],
          "title": "Origin",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        }
      },
      "required": [
        "id",
        "action"
      ],
      "title": "Step",
      "type": "object"
    },
    "Target": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "locators": {
          "items": {
            "$ref": "#/$defs/Locator"
          },
          "minItems": 1,
          "title": "Locators",
          "type": "array"
        }
      },
      "required": [
        "locators"
      ],
      "title": "Target",
      "type": "object"
    },
    "ThenAction": {
      "additionalProperties": false,
      "properties": {
        "outcome": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Outcome"
        },
        "fail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fail"
        },
        "escalate": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Escalate"
        }
      },
      "title": "ThenAction",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "kind": {
      "const": "product_profile",
      "default": "product_profile",
      "title": "Kind",
      "type": "string"
    },
    "product": {
      "title": "Product",
      "type": "string"
    },
    "display_name": {
      "title": "Display Name",
      "type": "string"
    },
    "version": {
      "title": "Version",
      "type": "string"
    },
    "surface": {
      "const": "web",
      "default": "web",
      "title": "Surface",
      "type": "string"
    },
    "capability_prefix": {
      "title": "Capability Prefix",
      "type": "string"
    },
    "entry": {
      "$ref": "#/$defs/Entry"
    },
    "session": {
      "$ref": "#/$defs/Session"
    },
    "global_screens": {
      "additionalProperties": {
        "$ref": "#/$defs/Screen"
      },
      "title": "Global Screens",
      "type": "object"
    },
    "screen_catalog": {
      "additionalProperties": {
        "$ref": "#/$defs/Screen"
      },
      "title": "Screen Catalog",
      "type": "object"
    },
    "test_inputs": {
      "additionalProperties": {
        "additionalProperties": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "type": "object"
      },
      "title": "Test Inputs",
      "type": "object"
    },
    "input_hints": {
      "additionalProperties": {
        "$ref": "#/$defs/InputHint"
      },
      "title": "Input Hints",
      "type": "object"
    },
    "shared_targets": {
      "additionalProperties": {
        "$ref": "#/$defs/Target"
      },
      "title": "Shared Targets",
      "type": "object"
    },
    "field_classification": {
      "items": {
        "$ref": "#/$defs/FieldRule"
      },
      "title": "Field Classification",
      "type": "array"
    }
  },
  "required": [
    "product",
    "display_name",
    "version",
    "capability_prefix",
    "entry",
    "session",
    "global_screens",
    "screen_catalog"
  ],
  "title": "ProductProfile",
  "type": "object"
}
